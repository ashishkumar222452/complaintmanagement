# Environment variables (NEVER commit .env files)
.env
.env.local
.env.production
.env.*
!.env.example
**/.env
**/.env.local
**/.env.production
**/.env.*
!**/.env.example

# Node.js
node_modules/
**/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

